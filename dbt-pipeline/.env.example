# dbt target: dev (DuckDB) or prod (Databricks)
DBT_TARGET=dev

# Dev: local DuckDB file
DUCKDB_PATH=rcm.duckdb

# Prod: Databricks SQL warehouse (required when DBT_TARGET=prod)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=rcm

# Elementary observability (prod only; disabled by default)
ENABLE_ELEMENTARY=false

# OpenLineage lineage events (disabled by default). When enabled, dbt
# seed/run/test/build go through the dbt-ol wrapper (pip install openlineage-dbt)
# and emit events to OPENLINEAGE_URL (e.g. a Marquez endpoint).
ENABLE_OPENLINEAGE=false
OPENLINEAGE_URL=
OPENLINEAGE_NAMESPACE=claimwise
# OPENLINEAGE_API_KEY=

# Phase 2: Snowflake (uncomment when enabled)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
