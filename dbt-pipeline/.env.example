# dbt target: dev (DuckDB) or prod (Databricks)
DBT_TARGET=dev

# Dev: local DuckDB file
DUCKDB_PATH=rcm.duckdb

# Prod: Databricks SQL warehouse (required when DBT_TARGET=prod)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=rcm

# Elementary observability (prod only)
ENABLE_ELEMENTARY=true

# Phase 2: Snowflake (uncomment when enabled)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
