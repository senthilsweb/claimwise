{
  "datasets": [
    {
      "name": "ds_exec",
      "displayName": "Executive Summary",
      "queryLines": [
        "select * from __CATALOG__.gold.mtr_executive_summary"
      ]
    },
    {
      "name": "ds_revenue_monthly",
      "displayName": "Revenue Monthly",
      "queryLines": [
        "select month, billed_amount, collected_amount, collection_rate_pct, claim_count, denied_count from __CATALOG__.gold.mtr_revenue_monthly"
      ]
    },
    {
      "name": "ds_revenue_unpivot",
      "displayName": "Billed vs Collected",
      "queryLines": [
        "select month, 'Billed' as measure, billed_amount as amount from __CATALOG__.gold.mtr_revenue_monthly\n",
        "union all\n",
        "select month, 'Collected' as measure, collected_amount as amount from __CATALOG__.gold.mtr_revenue_monthly"
      ]
    },
    {
      "name": "ds_funnel",
      "displayName": "Claims Funnel",
      "queryLines": [
        "select claim_status, claim_count, total_amount, pct_of_claims from __CATALOG__.gold.mtr_claims_funnel"
      ]
    },
    {
      "name": "ds_payer",
      "displayName": "Payer Scorecard",
      "queryLines": [
        "select payer_name, billed_amount, collected_amount, collection_rate_pct, denial_rate_pct, open_ar, claim_count, avg_claim_amount from __CATALOG__.gold.mtr_payer_scorecard"
      ]
    },
    {
      "name": "ds_aging",
      "displayName": "AR Aging",
      "queryLines": [
        "select payer_name, aging_bucket, bucket_order, open_claim_count, open_ar_amount from __CATALOG__.gold.mtr_ar_aging"
      ]
    },
    {
      "name": "ds_dept",
      "displayName": "Department Activity",
      "queryLines": [
        "select specialty, encounter_count, unique_patients, active_doctors, avg_duration_minutes, emergency_visits from __CATALOG__.gold.mtr_department_activity"
      ]
    }
  ],
