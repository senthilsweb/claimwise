                    {
                      "name": "gross_billed",
                      "expression": "SUM(`gross_billed`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "showTitle": true,
                "title": "Gross Billed"
              },
              "encodings": {
                "value": {
                  "fieldName": "gross_billed",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  },
                  "displayName": "Gross Billed"
